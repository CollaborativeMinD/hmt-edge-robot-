{
  "apiVersion": "source.toolkit.fluxcd.io/v1",
  "kind": "GitRepository",
  "metadata": {
    "name": "hmt-edge-source",
    "namespace": "hmt-edge-robot-sil"
  },
  "spec": {
    "suspend": true,
    "interval": "5m",
    "timeout": "30s",
    "url": "ssh://git@github.com/CollaborativeMinD/hmt-edge-robot-.git",
    "ref": {
      "commit": "{{APPROVED_RELEASE_COMMIT_REQUIRED}}"
    },
    "secretRef": {
      "name": "hmt-edge-git-read"
    }
  }
}
