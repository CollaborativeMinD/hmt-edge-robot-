{
  "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
  "kind": "Kustomization",
  "metadata": {
    "name": "hmt-edge-sil",
    "namespace": "hmt-edge-robot-sil"
  },
  "spec": {
    "suspend": true,
    "interval": "5m",
    "timeout": "120s",
    "prune": false,
    "path": "./deploy/stage3/workload",
    "targetNamespace": "hmt-edge-robot-sil",
    "serviceAccountName": "hmt-edge-reconciler",
    "wait": true,
    "sourceRef": {
      "kind": "GitRepository",
      "name": "hmt-edge-source"
    }
  }
}
