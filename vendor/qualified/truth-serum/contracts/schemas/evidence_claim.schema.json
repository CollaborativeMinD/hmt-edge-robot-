{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-serum.local/contracts/evidence_claim.schema.json",
  "title": "Truth Serum evidence claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "statement", "file_path", "sha256"],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "statement": {"type": "string", "minLength": 1},
    "file_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
