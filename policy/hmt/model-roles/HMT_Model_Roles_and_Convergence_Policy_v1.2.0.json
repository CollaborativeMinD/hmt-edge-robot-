    "evaluation_basis": "role_specific_requirement_bound_acceptance_criteria_no_universal_quality_threshold_invented",
    "failure_transition": "SYSTEM_REQUIREMENTS_REVIEW",
    "local_definition": "model inference executes on admitted organization-controlled hardware without remote model-provider inference dependency for the bounded role",
    "moe_active_parameter_count_alone_is_sufficient": false,
    "parameter_ceiling_semantics": "32B_total_parameter_default_ceiling; MoE active parameter count alone does not substitute for total model size; quantization changes memory footprint, not parameter count",
    "policy_id": "HMT-LMV-001",
    "prohibitions": [
      "model_reselection_as_first_response_to_unreviewed_system_failure",
      "cloud_or_oversized_model_as_architecture_patch",
