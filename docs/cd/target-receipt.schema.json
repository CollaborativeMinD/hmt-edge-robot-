{
  "$defs": {
    "InventoryReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "inventory_status": {
          "const": "PASS",
          "title": "Inventory Status",
          "type": "string"
        },
        "target_qualification": {
          "const": "HOLD",
          "title": "Target Qualification",
          "type": "string"
        },
        "deployment": {
          "const": "HOLD",
          "title": "Deployment",
          "type": "string"
        },
        "physical_actuation": {
          "const": "HOLD",
          "title": "Physical Actuation",
          "type": "string"
        },
        "authority": {
          "const": "INVENTORY_CONSISTENCY_ONLY",
          "title": "Authority",
          "type": "string"
        },
        "assessed_at": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assessed At",
          "type": "string"
        },
        "policy_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]*[a-f1-9][a-f0-9]*$",
          "title": "Policy Hash",
          "type": "string"
        },
        "collector_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]*[a-f1-9][a-f0-9]*$",
          "title": "Collector Hash",
          "type": "string"
        },
        "captures": {
          "additionalProperties": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[a-f0-9]*[a-f1-9][a-f0-9]*$",
            "type": "string"
          },
          "maxProperties": 3,
          "minProperties": 3,
          "propertyNames": {
            "enum": [
              "forge-pi-01",
              "forge-pi-02",
              "forge-pi-03"
            ]
          },
          "title": "Captures",
          "type": "object"
        },
        "reason_codes": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 11,
          "title": "Reason Codes",
          "type": "array"
        },
        "alert": {
          "const": true,
          "title": "Alert",
          "type": "boolean"
        },
        "receipt_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]*[a-f1-9][a-f0-9]*$",
          "title": "Receipt Hash",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "inventory_status",
        "target_qualification",
        "deployment",
        "physical_actuation",
        "authority",
        "assessed_at",
        "policy_hash",
        "collector_hash",
        "captures",
        "reason_codes",
        "alert",
        "receipt_hash"
      ],
      "title": "InventoryReceipt",
      "type": "object"
    },
    "Rejection": {
      "additionalProperties": false,
      "properties": {
        "inventory_status": {
          "const": "FAIL",
          "title": "Inventory Status",
          "type": "string"
        },
        "target_qualification": {
          "const": "HOLD",
          "title": "Target Qualification",
          "type": "string"
        },
        "deployment": {
          "const": "HOLD",
          "title": "Deployment",
          "type": "string"
        },
        "physical_actuation": {
          "const": "HOLD",
          "title": "Physical Actuation",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "ASSESSMENT_INCOMPLETE",
              "TARGET_ASSESSMENT_REJECTED"
            ],
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "alert": {
          "const": true,
          "title": "Alert",
          "type": "boolean"
        }
      },
      "required": [
        "inventory_status",
        "target_qualification",
        "deployment",
        "physical_actuation",
        "reason_codes",
        "alert"
      ],
      "title": "Rejection",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "FAIL": "#/$defs/Rejection",
      "PASS": "#/$defs/InventoryReceipt"
    },
    "propertyName": "inventory_status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/InventoryReceipt"
    },
    {
      "$ref": "#/$defs/Rejection"
    }
  ]
}
