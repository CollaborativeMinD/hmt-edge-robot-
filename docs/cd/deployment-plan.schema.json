{
  "$defs": {
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "maxLength": 40,
          "minLength": 40,
          "pattern": "^[a-f0-9]*[a-f1-9][a-f0-9]*$",
          "title": "Commit",
          "type": "string"
        },
        "tree": {
          "maxLength": 40,
          "minLength": 40,
          "pattern": "^[a-f0-9]*[a-f1-9][a-f0-9]*$",
          "title": "Tree",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "Boundaries": {
      "additionalProperties": false,
      "properties": {
        "image_build": {
          "const": "HOLD",
