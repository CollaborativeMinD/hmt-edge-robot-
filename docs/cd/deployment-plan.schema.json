      "title": "Boundaries",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "request_cpu_m": {
          "maximum": 2000,
          "minimum": 100,
          "title": "Request Cpu M",
          "type": "integer"
        },
        "limit_cpu_m": {
          "maximum": 2000,
          "minimum": 100,
          "title": "Limit Cpu M",
          "type": "integer"
        },
        "request_memory_mib": {
          "maximum": 2048,
          "minimum": 256,
          "title": "Request Memory Mib",
          "type": "integer"
        },
        "limit_memory_mib": {
          "maximum": 2048,
          "minimum": 256,
          "title": "Limit Memory Mib",
          "type": "integer"
        },
        "qualification": {
          "const": "HOLD",
          "title": "Qualification",
          "type": "string"
        }
      },
      "required": [
        "request_cpu_m",
        "limit_cpu_m",
        "request_memory_mib",
        "limit_memory_mib",
        "qualification"
